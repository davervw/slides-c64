   285  1dce 8564                   sta len ; prep upcoming loop at the same time
   286  1dd0 20f11d                 jsr addbyteto_src_p
   287                          
   288                              ; advance past color and text rle data using their lengths
   289  1dd3 a001               -   ldy #1
   290  1dd5 b1fb                   lda (src_p),y
   291  1dd7 aa                     tax
   292  1dd8 88                     dey
   293  1dd9 b1fb                   lda (src_p),y
   294  1ddb 20f31d                 jsr addto_src_p
   295  1dde c664                   dec len
   296  1de0 d0f1                   bne -
