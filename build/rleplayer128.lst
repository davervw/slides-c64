    36                          
    37                          chrout = $FFD2 ; character out to device (normally screen)
    38                          getin = $FFE4 ; read character from keyboard, 0=no key
    39                          plot = $FFF0 ; C clear sets cursor position X=row, Y=col, or if C set gets cursor position
    40                          
    41                          !ifdef TARGET_C64 {
    42                          src_p=$FB
    43                          src_h=$FC
    44                          dst_p=$FD
    45                          dst_h=$FE
    46                          special=$FF
    47                          end_src_p=$22
    48                          end_src_h=$23
    49                          value=$24
    50                          len=$25
    51                          pages=$26 ; count of pages indexed
    52                          page=$27 ; 0 based
    53                          save_border=$28
    54                          save_background=$29
    55                          save_foreground=$2a
    56                          
    57                          screen_index = $33C
    58                          max_pages = 96
    59                          
    60                          text_addr=$0400
    61                          color_addr=$d800
    62                          
    63                          border=$d020
    64                          background=$d021
    65                          foreground=646
    66                          
    67                          *=$801
    68                          
    69                          ; 10 SYS 2062
    70                          !byte <end_basic, >end_basic
    71                          !text 10, 0, $9E, " 2062", 0
    72                          end_basic:
    73                          !byte 0, 0
    74                          }
    75                          
    76                          !ifdef TARGET_C128 {
    77                          src_p=$FB
    78                          src_h=$FC
    79                          dst_p=$FD
    80                          dst_h=$FE
    81                          special=$FA
    82                          end_src_p=$61
    83                          end_src_h=$62
    84                          value=$63
    85                          len=$64
    86                          pages=$65
    87                          page=$66
    88                          save_border=$67
    89                          save_background=$68
    90                          save_foreground=$69
    91                          
    92                          screen_index=$0B00
    93                          max_pages=127
    94                          
    95                          text_addr=$0400
    96                          color_addr=$d800
    97                          
    98                          border=$d020
    99                          background=$d021
   100                          foreground=241
   101                          
   102                          *=$1C01
   103                          
   104                          ; 10 graphic 5,1:printchr$(15)"graphic 0 !!!":graphic 0
   105  1c01 251c0a00de20352c...!byte $25,$1c,$0a,$00,$de,$20,$35,$2c,$31,$3a,$99,$c7,$28,$31,$35,$29
   106  1c11 2247524150484943...!byte $22,$47,$52,$41,$50,$48,$49,$43,$20,$30,$20,$21,$21,$21,$22,$3a
   107  1c21 de203000           !byte $de,$20,$30,$00
   108                          
   109                          ; 20 bank 15:sys 7224
   110  1c25 361c1400fe022031...!text $36,$1c,$14,$00,$fe,$02,$20,$31,$35,$3a,$9e," 7224",$00
   111                          
   112                          end_basic:
   113  1c36 0000               !byte 0, 0
   114                          }
   115                          
   116                          !ifdef TARGET_TED { ; Commodore 16, 116, Plus/4, etc.
   117                          src_p=$60
   118                          src_h=$61
   119                          dst_p=$62
   120                          dst_h=$63
   121                          special=$64
   122                          end_src_p=$65
   123                          end_src_h=$66
   124                          value1=$67
   125                          value2=$68
   126                          len=$69
   127                          pages=$6A
   128                          page=$6B
   129                          save_border=$6C
   130                          save_background=$6D
   131                          save_foreground=$6E
   132                          
   133                          screen_index=$333
   134                          max_pages=96
   135                          
   136                          text_addr=$0c00
   137                          color_addr=$0800
   138                          
   139                          *=$1001
   140                          
   141                          ; 10 SYS 4110
   142                          !byte <end_basic, >end_basic
   143                          !text 10, 0, $9E, " 4110", 0, 0
   144                          end_basic:
   145                          !byte 0
   146                          }
   147                          
   148                          screen_player:
   149  1c38 4c441c                 jmp main
   150                          
   151                          set_slide_colors:
   152  1c3b a905                   lda #$05 ; 0E=C64 foreground
   153  1c3d a206                   ldx #$06
   154  1c3f a00e                   ldy #$0e
   155                          !ifdef TARGET_TED {
   156                              jmp xlat_set_colors
   157                          } else {
   158  1c41 4ca51e                 jmp set_colors
   159                          }
   160                          
   161                          main:
   162  1c44 20ae1e                 jsr save_colors
   163  1c47 203b1c                 jsr set_slide_colors
   164  1c4a a90e                   lda #$0E ; 0E=lowercase, otherwise 93=clearscreen
   165  1c4c 20d2ff                 jsr chrout
   166                          !ifdef TARGET_C128 {
   167  1c4f 20d31e                 jsr sei_c128_ram_bank
   168                          }
   169                          !ifdef TARGET_TED {
   170                              jsr sei_ted_ram_bank
   171                          }
   172  1c52 a9f3                   lda #<start_data
   173  1c54 a21e                   ldx #>start_data
   174  1c56 85fb                   sta src_p
   175  1c58 86fc                   stx src_h
   176  1c5a 20d91d                 jsr index_data
   177                          screen_loop: 
   178                          !ifdef TARGET_C128 {
   179  1c5d 20d31e                 jsr sei_c128_ram_bank
   180                          }
   181                          !ifdef TARGET_TED {
   182                              jsr sei_ted_ram_bank
   183                          }
   184  1c60 a566                   lda page
   185  1c62 c565                   cmp pages
   186  1c64 9003                   bcc +
   187  1c66 4c341e                 jmp exit_basic
   188  1c69 0a                 +   asl
   189  1c6a a8                     tay
   190  1c6b b9000b                 lda screen_index,y
   191  1c6e be010b                 ldx screen_index+1,y
   192  1c71 85fb                   sta src_p
   193  1c73 86fc                   stx src_h
   194  1c75 a902                   lda #2
   195  1c77 20271e                 jsr addbyteto_src_p
   196  1c7a a900                   lda #<color_addr
   197  1c7c a2d8                   ldx #>color_addr
   198  1c7e 85fd                   sta dst_p
   199  1c80 86fe                   stx dst_h
   200  1c82 20f61c                 jsr decode_color
   201  1c85 a900                   lda #<text_addr
   202  1c87 a204                   ldx #>text_addr
   203  1c89 85fd                   sta dst_p
   204  1c8b 86fe                   stx dst_h
   205  1c8d 20711d                 jsr decode_text
   206                          !ifdef TARGET_C128 {    
   207  1c90 20da1e                 jsr c128_rom_bank_cli
   208                          }
   209                          !ifdef TARGET_TED {    
   210                              jsr ted_rom_bank_cli
   211                          }
   212  1c93 20e4ff             -   jsr getin
   213  1c96 c900                   cmp #$00
   214  1c98 f0f9                   beq -
   215  1c9a c958                   cmp #'X'
   216  1c9c d003                   bne +
   217  1c9e 4c941e                 jmp exit_basic_x
   218  1ca1 c91b               +   cmp #27 ; ESC
   219  1ca3 f004                   beq +
   220  1ca5 c903                   cmp #3
   221  1ca7 d008                   bne ++
   222  1ca9 a993               +   lda #$93
   223  1cab 20d2ff                 jsr chrout
   224  1cae 4c341e                 jmp exit_basic
   225  1cb1 c914               ++  cmp #20 ; delete
   226  1cb3 d009                   bne +
   227  1cb5 a566               --  lda page ; check if can backup a page
   228  1cb7 f0da                   beq -
   229  1cb9 c666                   dec page
   230  1cbb 4cee1c                 jmp ++
   231  1cbe c913               +   cmp #19 ; home
   232  1cc0 d007                   bne +
   233  1cc2 a900                   lda #0
   234  1cc4 8566                   sta page
   235  1cc6 4cee1c                 jmp ++
   236  1cc9 c99d               +   cmp #157 ; left
   237  1ccb f0e8                   beq --
   238  1ccd c991                   cmp #145 ; up
   239  1ccf f0e4                   beq --
   240  1cd1 c931                   cmp #'1'
   241  1cd3 900f                   bcc +
   242  1cd5 c93a                   cmp #('9'+1)
   243  1cd7 b00b                   bcs +
   244  1cd9 38                     sec        ; 1..9
   245  1cda e931                   sbc #'1'   ; because 0 based
   246  1cdc c565               --  cmp pages
   247  1cde b0b3                   bcs -      ; ignore key if out of range
   248  1ce0 8566                   sta page
   249  1ce2 900a                   bcc ++
   250  1ce4 c930               +   cmp #'0'
   251  1ce6 d004                   bne +
   252  1ce8 a90a                   lda #10    ; try page 10
   253  1cea d0f0                   bne --   
   254  1cec e666               +   inc page   ; any other key, advance page
   255                          ++
   256  1cee a993                   lda #$93   ; before switching page, clear screen
   257  1cf0 20d2ff                 jsr chrout
   258  1cf3 4c5d1c                 jmp screen_loop
   259                          
   260                          !ifdef TARGET_TED {
   261                          decode_color:
   262                              clc
   263                              ldy #$00
   264                              lda (src_p),y
   265                              adc src_p
   266                              sta end_src_p
   267                              iny
   268                              lda (src_p),y
   269                              adc src_h
   270                              sta end_src_h
   271                              iny
   272                              lda (src_p),y
   273                              sta special
   274                              lda #3
   275                              jsr addbyteto_src_p
   276                          color_loop: 
   277                              ldy #$00
   278                              lda (src_p),y
   279                              cmp special
   280                              beq ++
   281                              pha
   282                              lsr
   283                              lsr
   284                              lsr
   285                              lsr
   286                              tax
   287                              lda color_table, x
   288                              sta (dst_p),y
   289                              pla
   290                              and #$0f
   291                              tax
   292                              lda color_table, x
   293                              iny
   294                              sta (dst_p),y
   295                              inc src_p
   296                              bne +
   297                              inc src_h
   298                          +   clc
   299                              lda dst_p
   300                              adc #$02
   301                              sta dst_p
   302                              bcc +
   303                              inc dst_h
   304                          +   jmp color_while
   305                          ++  iny
   306                              lda (src_p),y
   307                              lsr
   308                              lsr
   309                              lsr
   310                              lsr
   311                              tax
   312                              lda color_table, x
   313                              sta value1
   314                              lda (src_p),y
   315                              and #$0F
   316                              tax
   317                              lda color_table, x
   318                              sta value2
   319                              iny
   320                              lda (src_p),y
   321                              sta len
   322                              lda #$03
   323                              clc
   324                              adc src_p
   325                              sta src_p
   326                              bcc +
   327                              inc src_h
   328                          +   ldx len
   329                          color_rle_loop:
   330                              ldy #0
   331                              lda value1
   332                              sta (dst_p),y
   333                              lda value2
   334                              iny
   335                              sta (dst_p),y
   336                              clc
   337                              lda dst_p
   338                              adc #$02
   339                              sta dst_p
   340                              bcc +
   341                              inc dst_h
   342                          +   dex
   343                              bne color_rle_loop
   344                          color_while:
   345                              lda src_p
   346                              ldx src_h
   347                              cpx end_src_h
   348                              bcc color_loop
   349                              bne +
   350                              cmp end_src_p
   351                              bcs +
   352                              jmp color_loop
   353                          +   rts
   354                          } else { ; TARGET_C64 or TARGET_C128
   355                          decode_color:
   356  1cf6 18                     clc
   357  1cf7 a000                   ldy #$00
   358  1cf9 b1fb                   lda (src_p),y
   359  1cfb 65fb                   adc src_p
   360  1cfd 8561                   sta end_src_p
   361  1cff c8                     iny
   362  1d00 b1fb                   lda (src_p),y
   363  1d02 65fc                   adc src_h
   364  1d04 8562                   sta end_src_h
   365  1d06 c8                     iny
   366  1d07 b1fb                   lda (src_p),y
   367  1d09 85fa                   sta special
   368  1d0b a903                   lda #3
   369  1d0d 20271e                 jsr addbyteto_src_p
   370                          color_loop: 
   371  1d10 a000                   ldy #$00
   372  1d12 b1fb                   lda (src_p),y
   373  1d14 c5fa                   cmp special
   374  1d16 f01e                   beq ++
   375  1d18 c8                     iny
   376  1d19 91fd                   sta (dst_p),y
   377  1d1b 88                     dey
   378  1d1c 4a                     lsr
   379  1d1d 4a                     lsr
   380  1d1e 4a                     lsr
   381  1d1f 4a                     lsr
   382  1d20 91fd                   sta (dst_p),y
   383  1d22 e6fb                   inc src_p
   384  1d24 d002                   bne +
   385  1d26 e6fc                   inc src_h
   386  1d28 18                 +   clc
   387  1d29 a5fd                   lda dst_p
   388  1d2b 6902                   adc #$02
   389  1d2d 85fd                   sta dst_p
   390  1d2f 9002                   bcc +
   391  1d31 e6fe                   inc dst_h
   392  1d33 4c621d             +   jmp color_while
   393  1d36 c8                 ++  iny
   394  1d37 b1fb                   lda (src_p),y
   395  1d39 8563                   sta value
   396  1d3b c8                     iny
   397  1d3c b1fb                   lda (src_p),y
   398  1d3e 8564                   sta len
   399  1d40 a903                   lda #3
   400  1d42 20271e                 jsr addbyteto_src_p
   401  1d45 a664                   ldx len
   402                          color_rle_loop: 
   403  1d47 a563                   lda value
   404  1d49 a001                   ldy #$01
   405  1d4b 91fd                   sta (dst_p),y
   406  1d4d 88                     dey
   407  1d4e 4a                     lsr
   408  1d4f 4a                     lsr
   409  1d50 4a                     lsr
   410  1d51 4a                     lsr
   411  1d52 91fd                   sta (dst_p),y
   412  1d54 18                     clc
   413  1d55 a5fd                   lda dst_p
   414  1d57 6902                   adc #$02
   415  1d59 85fd                   sta dst_p
   416  1d5b 9002                   bcc +
   417  1d5d e6fe                   inc dst_h
   418  1d5f ca                 +   dex
   419  1d60 d0e5                   bne color_rle_loop
   420                          color_while:
   421  1d62 a5fb                   lda src_p
   422  1d64 a6fc                   ldx src_h
   423  1d66 e462                   cpx end_src_h
   424  1d68 90a6                   bcc color_loop
   425  1d6a d004                   bne +
   426  1d6c c561                   cmp end_src_p
   427  1d6e 90a0                   bcc color_loop
   428  1d70 60                 +   rts
   429                          }
   430                          
   431                          decode_text:
   432  1d71 18                     clc
   433  1d72 a000                   ldy #$00
   434  1d74 b1fb                   lda (src_p),y
   435  1d76 65fb                   adc src_p
   436  1d78 8561                   sta end_src_p
   437  1d7a c8                     iny
   438  1d7b b1fb                   lda (src_p),y
   439  1d7d 65fc                   adc src_h
   440  1d7f 8562                   sta end_src_h
   441  1d81 c8                     iny
   442  1d82 b1fb                   lda (src_p),y
   443  1d84 85fa                   sta special
   444  1d86 a903                   lda #3
   445  1d88 20271e                 jsr addbyteto_src_p
   446                          text_loop:
   447  1d8b a000                   ldy #$00
   448  1d8d b1fb                   lda (src_p),y
   449  1d8f c5fa                   cmp special
   450  1d91 f011                   beq ++
   451  1d93 91fd                   sta (dst_p),y
   452  1d95 e6fb                   inc src_p
   453  1d97 d002                   bne +
   454  1d99 e6fc                   inc src_h
   455  1d9b e6fd               +   inc dst_p
   456  1d9d d002                   bne +
   457  1d9f e6fe                   inc dst_h
   458  1da1 4cca1d             +   jmp text_while
   459  1da4 c8                 ++  iny
   460  1da5 b1fb                   lda (src_p),y
   461                          !ifdef TARGET_TED {
   462                              sta value1
   463                          } else {
   464  1da7 8563                   sta value
   465                          }
   466  1da9 c8                     iny
   467  1daa b1fb                   lda (src_p),y
   468  1dac 8564                   sta len
   469  1dae a903                   lda #$03
   470  1db0 18                     clc
   471  1db1 65fb                   adc src_p
   472  1db3 85fb                   sta src_p
   473  1db5 9002                   bcc +
   474  1db7 e6fc                   inc src_h
   475  1db9 a664               +   ldx len
   476                          text_rle_loop: 
   477                          !ifdef TARGET_TED {
   478                              lda value1
   479                          } else {
   480  1dbb a563                   lda value
   481                          }
   482  1dbd a000                   ldy #$00
   483  1dbf 91fd                   sta (dst_p),y
   484  1dc1 e6fd                   inc dst_p
   485  1dc3 d002                   bne +
   486  1dc5 e6fe                   inc dst_h
   487  1dc7 ca                 +   dex
   488  1dc8 d0f1                   bne text_rle_loop
   489                          text_while:
   490  1dca a5fb                   lda src_p
   491  1dcc a6fc                   ldx src_h
   492  1dce e462                   cpx end_src_h
   493  1dd0 90b9                   bcc text_loop
   494  1dd2 d004                   bne +
   495  1dd4 c561                   cmp end_src_p
   496  1dd6 90b3                   bcc text_loop
   497  1dd8 60                 +   rts
   498                          
   499                          index_data:
   500  1dd9 a900                   lda #0
   501  1ddb 8565                   sta pages
   502  1ddd 8566                   sta page
   503                              
   504                          index_loop:
   505                              ; setup index storage offset in .X
   506                              ; .A already has pages
   507  1ddf 0a                     asl
   508  1de0 aa                     tax
   509                          
   510                              ; set next index to 0000
   511  1de1 a900                   lda #0
   512  1de3 9d000b                 sta screen_index, x
   513  1de6 9d010b                 sta screen_index+1, x
   514                          
   515                              ; do check for start of page (C600 address)
   516  1de9 a000                   ldy #0
   517  1deb b1fb                   lda (src_p),y
   518  1ded d02f                   bne index_exit
   519  1def c8                     iny
   520  1df0 b1fb                   lda (src_p),y
   521  1df2 c9c6                   cmp #$c6
   522  1df4 d028                   bne index_exit
   523                          
   524                              ; store indexed page
   525  1df6 a5fb                   lda src_p
   526  1df8 9d000b                 sta screen_index, x
   527  1dfb a5fc                   lda src_h
   528  1dfd 9d010b                 sta screen_index+1, x
   529  1e00 e665                   inc pages
   530                          
   531                              ; skip C600 address
   532  1e02 a902                   lda #2
   533  1e04 8564                   sta len ; prep upcoming loop at the same time
   534  1e06 20271e                 jsr addbyteto_src_p
   535                          
   536                              ; advance past color and text rle data using their lengths
   537  1e09 a001               -   ldy #1
   538  1e0b b1fb                   lda (src_p),y
   539  1e0d aa                     tax
   540  1e0e 88                     dey
   541  1e0f b1fb                   lda (src_p),y
   542  1e11 20291e                 jsr addto_src_p
   543  1e14 c664                   dec len
   544  1e16 d0f1                   bne -
   545                          
   546                              ; while pages < max_pages
   547  1e18 a565                   lda pages
   548  1e1a c97f                   cmp #max_pages
   549  1e1c 90c1                   bcc index_loop
   550                          
   551                          index_exit:
   552  1e1e a9f3                   lda #<start_data
   553  1e20 a21e                   ldx #>start_data
   554  1e22 85fb                   sta src_p
   555  1e24 86fc                   stx src_h
   556  1e26 60                     rts
   557                          
   558                          addbyteto_src_p: ; ; A low, !! Warning: X is set to 0 !! fall through to 16-bit add
   559  1e27 a200                   ldx #0
   560                          addto_src_p: ; A low, X high, perform 16-bit addition from/to src_p/src_h
   561  1e29 18                     clc
   562  1e2a 65fb                   adc src_p
   563  1e2c 85fb                   sta src_p
   564  1e2e 8a                     txa
   565  1e2f 65fc                   adc src_h
   566  1e31 85fc                   sta src_h
   567  1e33 60                     rts
   568                          
   569                          exit_basic:
   570  1e34 a900                   lda #0
   571  1e36 aa                     tax
   572  1e37 a001                   ldy #1
   573                          !ifdef TARGET_TED {
   574                              jsr xlat_set_colors
   575                          } else {
   576  1e39 20a51e                 jsr set_colors
   577                          }
   578                          !ifdef TARGET_C128 {    
   579  1e3c 20da1e                 jsr c128_rom_bank_cli
   580                          }
   581                          !ifdef TARGET_TED {    
   582                              jsr ted_rom_bank_cli
   583                          }
   584  1e3f a20c                   ldx #12
   585  1e41 a00c                   ldy #(20-exit_message_len/2)
   586  1e43 18                     clc
   587  1e44 20f0ff                 jsr plot
   588  1e47 a9e1                   lda #<exit_message
   589  1e49 a21e                   ldx #>exit_message
   590  1e4b 20bd1e                 jsr string_out
   591  1e4e 20e4ff             --  jsr getin
   592  1e51 c900                   cmp #0
   593  1e53 f0f9                   beq --
   594  1e55 c913                   cmp #19
   595  1e57 d017                   bne ++
   596  1e59 a900                   lda #0
   597  1e5b 8566                   sta page
   598  1e5d a993               -   lda #$93
   599  1e5f 20d2ff                 jsr chrout
   600  1e62 203b1c                 jsr set_slide_colors
   601  1e65 a566                   lda page
   602  1e67 c565                   cmp pages
   603  1e69 9002                   bcc +
   604  1e6b c666                   dec page
   605  1e6d 4c5d1c             +   jmp screen_loop
   606  1e70 c914               ++  cmp #20 ; del (backspace)
   607  1e72 f0e9                   beq -
   608  1e74 c99d                   cmp #157 ; left
   609  1e76 f0e5                   beq -
   610  1e78 c991                   cmp #145 ; up
   611  1e7a f0e1                   beq -
   612  1e7c c931                   cmp #'1'
   613  1e7e 9010                   bcc +
   614  1e80 c93a                   cmp #('9'+1)
   615  1e82 b00c                   bcs +
   616  1e84 38                     sec
   617  1e85 e931                   sbc #'1'
   618  1e87 c565                   cmp pages
   619  1e89 b0c3                   bcs --
   620  1e8b 8566                   sta page
   621  1e8d 4c5d1e                 jmp -
   622  1e90 c958               +   cmp #'X'
   623  1e92 d0ba                   bne --
   624                          exit_basic_x:
   625                          !ifdef TARGET_C128 {
   626  1e94 20da1e                 jsr c128_rom_bank_cli
   627                          }
   628  1e97 a567                   lda save_border
   629  1e99 a668                   ldx save_background
   630  1e9b a469                   ldy save_foreground
   631                          !ifdef TARGET_TED {
   632                              jsr set_ted_colors ; no translation
   633                              ldy #14
   634                          -   lda #0
   635                              sta src_p,y
   636                              dey
   637                              bpl -
   638                              jsr ted_rom_bank_cli
   639                          } else {
   640  1e9d 20a51e                 jsr set_colors
   641                          }
   642  1ea0 a993                   lda #$93
   643  1ea2 4cd2ff                 jmp chrout ; and exit to BASIC
   644                          
   645                          !ifdef TARGET_TED {
   646                          xlat_set_colors:
   647                              sta value1
   648                              lda color_table,x
   649                              sta $ff15 ; background
   650                              ldx value1
   651                              lda color_table,x
   652                              sta $ff19 ; border
   653                              lda color_table,y
   654                              sta $053B ; foreground (KERNAL)
   655                              rts
   656                          
   657                          save_colors:
   658                              lda $ff15
   659                              ldx $ff19
   660                              ldy $053B
   661                              sta save_border
   662                              stx save_background
   663                              sty save_foreground
   664                              rts
   665                          
   666                          set_ted_colors:
   667                              sta $ff15
   668                              stx $ff19
   669                              sty $053B
   670                              rts
   671                          } else { ; TARGET_C64 OR TARGET_C128
   672                          set_colors:
   673  1ea5 8d20d0                 sta border
   674  1ea8 8e21d0                 stx background   
   675  1eab 84f1                   sty foreground
   676  1ead 60                     rts
   677                          
   678                          save_colors:
   679  1eae ad20d0                 lda border
   680  1eb1 ae21d0                 ldx background
   681  1eb4 a4f1                   ldy foreground
   682  1eb6 8567                   sta save_border
   683  1eb8 8668                   stx save_background
   684  1eba 8469                   sty save_foreground
   685  1ebc 60                     rts
   686                          }
   687                          
   688                          string_out:
   689  1ebd 85fb                   sta src_p
   690  1ebf 86fc                   stx src_h
   691  1ec1 a000                   ldy #0
   692  1ec3 b1fb               -   lda (src_p), y
   693  1ec5 f00b                   beq +
   694  1ec7 20d2ff                 jsr chrout
   695  1eca c8                     iny
   696  1ecb d0f6                   bne -
   697  1ecd e6fc                   inc src_h
   698  1ecf 4cc31e                 jmp -
   699  1ed2 60                 +   rts
   700                          
   701                          !ifdef TARGET_C128 {
   702                          sei_c128_ram_bank:
   703  1ed3 78                     sei
   704  1ed4 a906                   lda #$06 ; RAM bank 0 0000-CFFF, IO D000-DFFF, KERNAL E000-FFFF
   705  1ed6 8d00ff                 sta $FF00
   706  1ed9 60                     rts
   707                          
   708                          c128_rom_bank_cli:
   709  1eda a900                   lda #$00
   710  1edc 8d00ff                 sta $FF00
   711  1edf 58                     cli
   712  1ee0 60                     rts
   713                          }
   714                          
   715                          !ifdef TARGET_TED {
   716                          sei_ted_ram_bank:
   717                              sei
   718                              sta $ff3f ; bank in RAM
   719                              rts
   720                          
   721                          ted_rom_bank_cli:
   722                              sta $ff3e ; bank in ROM
   723                              cli
   724                              rts
   725                          }
   726                          
   727                          exit_message:
   728  1ee1 2850524553532058...    !text "(PRESS X TO EXIT)"
   729                          exit_message_len = * - exit_message    
   730  1ef2 00                     !byte 0
