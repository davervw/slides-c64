   256                          index_loop:
   257                              ; setup index storage offset in .X
   258                              ; .A already has pages
   259  1da9 0a                     asl
   260  1daa aa                     tax
   261                          
   262                              ; set next index to 0000
   263  1dab a900                   lda #0
   264  1dad 9d000b                 sta screen_index, x
   265  1db0 9d010b                 sta screen_index+1, x
   266                          
   267                              ; do check for start of page (C600 address)
   268  1db3 a000                   ldy #0
   269  1db5 b1fb                   lda (src_p),y
   270  1db7 d02f                   bne index_exit
   271  1db9 c8                     iny
   272  1dba b1fb                   lda (src_p),y
   273  1dbc c9c6                   cmp #$c6
   274  1dbe d028                   bne index_exit
   275                          
