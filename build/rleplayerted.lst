   471                          decode_text:
   472  11bb 18                     clc
   473  11bc a000                   ldy #$00
   474  11be b160                   lda (src_p),y
   475  11c0 6560                   adc src_p
   476  11c2 8565                   sta end_src_p
   477  11c4 c8                     iny
   478  11c5 b160                   lda (src_p),y
   479  11c7 6561                   adc src_h
   480  11c9 8566                   sta end_src_h
   481  11cb c8                     iny
   482  11cc b160                   lda (src_p),y
   483  11ce 8564                   sta special
   484  11d0 a903                   lda #3
   485  11d2 207112                 jsr addbyteto_src_p
   486                          text_loop:
   487  11d5 a000                   ldy #$00
   488  11d7 b160                   lda (src_p),y
   489  11d9 c564                   cmp special
   490  11db f011                   beq ++
   491  11dd 9162                   sta (dst_p),y
   492  11df e660                   inc src_p
   493  11e1 d002                   bne +
   494  11e3 e661                   inc src_h
   495  11e5 e662               +   inc dst_p
   496  11e7 d002                   bne +
   497  11e9 e663                   inc dst_h
   498  11eb 4c1412             +   jmp text_while
   499  11ee c8                 ++  iny
   500  11ef b160                   lda (src_p),y
   501                          !ifdef TARGET_TED {
   502  11f1 8567                   sta value1
   503                          } else {
   504                              sta value
   505                          }
   506  11f3 c8                     iny
   507  11f4 b160                   lda (src_p),y
   508  11f6 8569                   sta len
   509  11f8 a903                   lda #$03
   510  11fa 18                     clc
   511  11fb 6560                   adc src_p
   512  11fd 8560                   sta src_p
   513  11ff 9002                   bcc +
   514  1201 e661                   inc src_h
   515  1203 a669               +   ldx len
   516                          text_rle_loop: 
   517                          !ifdef TARGET_TED {
   518  1205 a567                   lda value1
   519                          } else {
   520                              lda value
   521                          }
   522  1207 a000                   ldy #$00
   523  1209 9162                   sta (dst_p),y
   524  120b e662                   inc dst_p
   525  120d d002                   bne +
   526  120f e663                   inc dst_h
   527  1211 ca                 +   dex
   528  1212 d0f1                   bne text_rle_loop
   529                          text_while:
   530  1214 a560                   lda src_p
   531  1216 a661                   ldx src_h
   532  1218 e466                   cpx end_src_h
   533  121a 90b9                   bcc text_loop
   534  121c d004                   bne +
   535  121e c565                   cmp end_src_p
   536  1220 90b3                   bcc text_loop
   537  1222 60                 +   rts
