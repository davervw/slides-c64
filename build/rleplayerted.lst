    37                          chrout = $FFD2 ; character out to device (normally screen)
    38                          getin = $FFE4 ; read character from keyboard, 0=no key
    39                          plot = $FFF0 ; C clear sets cursor position X=row, Y=col, or if C set gets cursor position
    40                          
    41                          !ifdef TARGET_C64 {
    42                          src_p=$FB
    43                          src_h=$FC
    44                          dst_p=$FD
    45                          dst_h=$FE
    46                          special=$FF
    47                          end_src_p=$22
    48                          end_src_h=$23
    49                          value=$24
    50                          len=$25
    51                          pages=$26 ; count of pages indexed
    52                          page=$27 ; 0 based
    53                          save_border=$28
    54                          save_background=$29
    55                          save_foreground=$2a
    56                          
    57                          screen_index = $33C
    58                          max_pages = 96
    59                          
    60                          text_addr=$0400
    61                          color_addr=$d800
    62                          
    63                          border=$d020
    64                          background=$d021
    65                          foreground=646
    66                          
    67                          *=$801
    68                          
    69                          ; 10 SYS 2062
    70                          !byte <end_basic, >end_basic
    71                          !text 10, 0, $9E, " 2062", 0
    72                          end_basic:
    73                          !byte 0, 0
    74                          }
    75                          
    76                          !ifdef TARGET_C128 {
    77                          src_p=$FB
    78                          src_h=$FC
