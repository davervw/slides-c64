    84  1086 f0e1                   beq -
    85  1088 c66b                   dec page
    86  108a 4cb210                 jmp ++
    87  108d c99d               +   cmp #157 ; left
    88  108f f0f3                   beq --
    89  1091 c991                   cmp #145 ; up
    90  1093 f0ef                   beq --
    91  1095 c931                   cmp #'1'
    92  1097 900f                   bcc +
    93  1099 c93a                   cmp #('9'+1)
    94  109b b00b                   bcs +
    95  109d 38                     sec        ; 1..9
    96  109e e931                   sbc #'1'   ; because 0 based
    97  10a0 c56a               --  cmp pages
