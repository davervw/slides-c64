   151                          set_slide_colors:
   152  1011 a905                   lda #$05 ; 0E=C64 foreground
   153  1013 a206                   ldx #$06
   154  1015 a00e                   ldy #$0e
   155                          !ifdef TARGET_TED {
   156  1017 4cf912                 jmp xlat_set_colors
   157                          } else {
   158                              jmp set_colors
   159                          }
   160                          
   161                          main:
   162  101a 201013                 jsr save_colors
   163  101d 201110                 jsr set_slide_colors
   164  1020 a90e                   lda #$0E ; 0E=lowercase, otherwise 93=clearscreen
   165  1022 20d2ff                 jsr chrout
   166                          !ifdef TARGET_C128 {
   167                              jsr sei_c128_ram_bank
   168                          }
   169                          !ifdef TARGET_TED {
   170  1025 204013                 jsr sei_ted_ram_bank
   171                          }
   172  1028 a96c                   lda #<start_data
   173  102a a213                   ldx #>start_data
   174  102c 8560                   sta src_p
   175  102e 8661                   stx src_h
   176  1030 202312                 jsr index_data
   177                          screen_loop: 
   178                          !ifdef TARGET_C128 {
   179                              jsr sei_c128_ram_bank
   180                          }
   181                          !ifdef TARGET_TED {
   182  1033 204013                 jsr sei_ted_ram_bank
   183                          }
   184  1036 a56b                   lda page
   185  1038 c56a                   cmp pages
   186  103a 9003                   bcc +
   187  103c 4c7e12                 jmp exit_basic
   188  103f 0a                 +   asl
   189  1040 a8                     tay
   190  1041 b93303                 lda screen_index,y
   191  1044 be3403                 ldx screen_index+1,y
   192  1047 8560                   sta src_p
   193  1049 8661                   stx src_h
   194  104b a902                   lda #2
   195  104d 207112                 jsr addbyteto_src_p
   196  1050 a900                   lda #<color_addr
   197  1052 a208                   ldx #>color_addr
   198  1054 8562                   sta dst_p
   199  1056 8663                   stx dst_h
   200  1058 201c11                 jsr decode_color
   201  105b a900                   lda #<text_addr
   202  105d a20c                   ldx #>text_addr
   203  105f 8562                   sta dst_p
   204  1061 8663                   stx dst_h
   205  1063 20bb11                 jsr decode_text
   206                          !ifdef TARGET_C128 {    
   207                              jsr c128_rom_bank_cli
   208                          }
   209                          !ifdef TARGET_TED {    
   210  1066 204513                 jsr ted_rom_bank_cli
   211                          }
   212  1069 20e4ff             -   jsr getin
   213  106c c900                   cmp #$00
   214  106e f0f9                   beq -
   215  1070 c958                   cmp #'X'
   216  1072 d003                   bne +
   217  1074 4cde12                 jmp exit_basic_x
   218  1077 c91b               +   cmp #27 ; ESC
   219  1079 f004                   beq +
   220  107b c903                   cmp #3
   221  107d d008                   bne ++
   222  107f a993               +   lda #$93
   223  1081 20d2ff                 jsr chrout
   224  1084 4c7e12                 jmp exit_basic
   225  1087 c914               ++  cmp #20 ; delete
   226  1089 d009                   bne +
   227  108b a56b               --  lda page ; check if can backup a page
   228  108d f0da                   beq -
   229  108f c66b                   dec page
   230  1091 4c1411                 jmp ++
   231  1094 c913               +   cmp #19 ; home
   232  1096 d007                   bne +
   233  1098 a900                   lda #0
   234  109a 856b                   sta page
   235  109c 4c1411                 jmp ++
   236  109f c99d               +   cmp #157 ; left
   237  10a1 f0e8                   beq --
   238  10a3 c991                   cmp #145 ; up
   239  10a5 f0e4                   beq --
   240  10a7 c931                   cmp #'1'
   241  10a9 900f                   bcc +
   242  10ab c93a                   cmp #('9'+1)
   243  10ad b00b                   bcs +
   244  10af 38                     sec        ; 1..9
   245  10b0 e931                   sbc #'1'   ; because 0 based
   246  10b2 c56a               --  cmp pages
   247  10b4 b0b3                   bcs -      ; ignore key if out of range
   248  10b6 856b                   sta page
   249  10b8 905a                   bcc ++
   250  10ba c930               +   cmp #'0'
   251  10bc d004                   bne +
   252  10be a909                   lda #9     ; try page 10 (zero based)
   253  10c0 d0f0                   bne --   
   254  10c2 c921               +   cmp #'!'
   255  10c4 d004                   bne +
   256  10c6 a90a                   lda #10     ; try page 11 (zero based)
   257  10c8 d0e8                   bne --   
   258  10ca c940               +   cmp #'@'
   259  10cc d004                   bne +
   260  10ce a90b                   lda #11     ; try page 12 (zero based)
   261  10d0 d0e0                   bne --   
   262  10d2 c923               +   cmp #'#'
   263  10d4 d004                   bne +
   264  10d6 a90c                   lda #12     ; try page 13 (zero based)
   265  10d8 d0d8                   bne --   
   266  10da c924               +   cmp #'$'
   267  10dc d004                   bne +
   268  10de a90d                   lda #13     ; try page 14 (zero based)
   269  10e0 d0d0                   bne --   
   270  10e2 c925               +   cmp #'%'
   271  10e4 d004                   bne +
   272  10e6 a90e                   lda #14     ; try page 15 (zero based)
   273  10e8 d0c8                   bne --   
   274  10ea c95e               +   cmp #'^'
   275  10ec d004                   bne +
   276  10ee a90f                   lda #15     ; try page 16 (zero based)
   277  10f0 d0c0                   bne --   
   278  10f2 c926               +   cmp #'&'
   279  10f4 d004                   bne +
   280  10f6 a910                   lda #16     ; try page 17 (zero based)
   281  10f8 d0b8                   bne --   
   282  10fa c92a               +   cmp #'*'
   283  10fc d004                   bne +
   284  10fe a911                   lda #17     ; try page 18 (zero based)
   285  1100 d0b0                   bne --   
   286  1102 c928               +   cmp #'('
   287  1104 d004                   bne +
   288  1106 a912                   lda #18     ; try page 19 (zero based)
   289  1108 d0a8                   bne --   
   290  110a c929               +   cmp #')'
   291  110c d004                   bne +
   292  110e a913                   lda #19     ; try page 20 (zero based)
   293  1110 d0a0                   bne --   
   294  1112 e66b               +   inc page   ; any other key, advance page
   295                          ++
   296  1114 a993                   lda #$93   ; before switching page, clear screen
   297  1116 20d2ff                 jsr chrout
   298  1119 4c3310                 jmp screen_loop
   299                          
   300                          !ifdef TARGET_TED {
   301                          decode_color:
   302  111c 18                     clc
   303  111d a000                   ldy #$00
   304  111f b160                   lda (src_p),y
   305  1121 6560                   adc src_p
   306  1123 8565                   sta end_src_p
   307  1125 c8                     iny
   308  1126 b160                   lda (src_p),y
   309  1128 6561                   adc src_h
   310  112a 8566                   sta end_src_h
   311  112c c8                     iny
   312  112d b160                   lda (src_p),y
   313  112f 8564                   sta special
   314  1131 a903                   lda #3
   315  1133 207112                 jsr addbyteto_src_p
   316                          color_loop: 
   317  1136 a000                   ldy #$00
   318  1138 b160                   lda (src_p),y
   319  113a c564                   cmp special
   320  113c f029                   beq ++
   321  113e 48                     pha
   322  113f 4a                     lsr
   323  1140 4a                     lsr
   324  1141 4a                     lsr
   325  1142 4a                     lsr
   326  1143 aa                     tax
   327  1144 bd5c13                 lda color_table, x
   328  1147 9162                   sta (dst_p),y
   329  1149 68                     pla
   330  114a 290f                   and #$0f
   331  114c aa                     tax
   332  114d bd5c13                 lda color_table, x
   333  1150 c8                     iny
   334  1151 9162                   sta (dst_p),y
   335  1153 e660                   inc src_p
   336  1155 d002                   bne +
   337  1157 e661                   inc src_h
   338  1159 18                 +   clc
   339  115a a562                   lda dst_p
   340  115c 6902                   adc #$02
   341  115e 8562                   sta dst_p
   342  1160 9002                   bcc +
   343  1162 e663                   inc dst_h
   344  1164 4ca911             +   jmp color_while
   345  1167 c8                 ++  iny
   346  1168 b160                   lda (src_p),y
   347  116a 4a                     lsr
   348  116b 4a                     lsr
   349  116c 4a                     lsr
   350  116d 4a                     lsr
   351  116e aa                     tax
   352  116f bd5c13                 lda color_table, x
   353  1172 8567                   sta value1
   354  1174 b160                   lda (src_p),y
   355  1176 290f                   and #$0F
   356  1178 aa                     tax
   357  1179 bd5c13                 lda color_table, x
   358  117c 8568                   sta value2
   359  117e c8                     iny
   360  117f b160                   lda (src_p),y
   361  1181 8569                   sta len
   362  1183 a903                   lda #$03
   363  1185 18                     clc
   364  1186 6560                   adc src_p
   365  1188 8560                   sta src_p
   366  118a 9002                   bcc +
   367  118c e661                   inc src_h
   368  118e a669               +   ldx len
   369                          color_rle_loop:
   370  1190 a000                   ldy #0
   371  1192 a567                   lda value1
   372  1194 9162                   sta (dst_p),y
   373  1196 a568                   lda value2
   374  1198 c8                     iny
   375  1199 9162                   sta (dst_p),y
   376  119b 18                     clc
   377  119c a562                   lda dst_p
   378  119e 6902                   adc #$02
   379  11a0 8562                   sta dst_p
   380  11a2 9002                   bcc +
   381  11a4 e663                   inc dst_h
   382  11a6 ca                 +   dex
   383  11a7 d0e7                   bne color_rle_loop
   384                          color_while:
   385  11a9 a560                   lda src_p
   386  11ab a661                   ldx src_h
   387  11ad e466                   cpx end_src_h
   388  11af 9085                   bcc color_loop
   389  11b1 d007                   bne +
   390  11b3 c565                   cmp end_src_p
   391  11b5 b003                   bcs +
   392  11b7 4c3611                 jmp color_loop
   393  11ba 60                 +   rts
   394                          } else { ; TARGET_C64 or TARGET_C128
   395                          decode_color:
   396                              clc
   397                              ldy #$00
   398                              lda (src_p),y
   399                              adc src_p
   400                              sta end_src_p
   401                              iny
   402                              lda (src_p),y
   403                              adc src_h
   404                              sta end_src_h
   405                              iny
   406                              lda (src_p),y
   407                              sta special
   408                              lda #3
   409                              jsr addbyteto_src_p
   410                          color_loop: 
   411                              ldy #$00
   412                              lda (src_p),y
   413                              cmp special
   414                              beq ++
   415                              iny
   416                              sta (dst_p),y
   417                              dey
   418                              lsr
   419                              lsr
   420                              lsr
   421                              lsr
   422                              sta (dst_p),y
   423                              inc src_p
   424                              bne +
   425                              inc src_h
   426                          +   clc
   427                              lda dst_p
   428                              adc #$02
   429                              sta dst_p
   430                              bcc +
   431                              inc dst_h
   432                          +   jmp color_while
   433                          ++  iny
   434                              lda (src_p),y
   435                              sta value
   436                              iny
   437                              lda (src_p),y
   438                              sta len
   439                              lda #3
   440                              jsr addbyteto_src_p
   441                              ldx len
   442                          color_rle_loop: 
   443                              lda value
   444                              ldy #$01
   445                              sta (dst_p),y
   446                              dey
   447                              lsr
   448                              lsr
   449                              lsr
   450                              lsr
   451                              sta (dst_p),y
   452                              clc
   453                              lda dst_p
   454                              adc #$02
   455                              sta dst_p
   456                              bcc +
   457                              inc dst_h
   458                          +   dex
   459                              bne color_rle_loop
   460                          color_while:
   461                              lda src_p
   462                              ldx src_h
   463                              cpx end_src_h
   464                              bcc color_loop
   465                              bne +
   466                              cmp end_src_p
   467                              bcc color_loop
   468                          +   rts
   469                          }
