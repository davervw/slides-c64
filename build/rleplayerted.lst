    87                          page=$66
    88                          save_border=$67
    89                          save_background=$68
    90                          save_foreground=$69
    91                          
    92                          screen_index=$0B00
    93                          max_pages=127
    94                          
    95                          text_addr=$0400
    96                          color_addr=$d800
    97                          
    98                          border=$d020
    99                          background=$d021
   100                          foreground=241
   101                          
   102                          *=$1C01
   103                          
   104                          ; 10 graphic 5,1:printchr$(15)"graphic 0 !!!":graphic 0
   105                          !byte $25,$1c,$0a,$00,$de,$20,$35,$2c,$31,$3a,$99,$c7,$28,$31,$35,$29
   106                          !byte $22,$47,$52,$41,$50,$48,$49,$43,$20,$30,$20,$21,$21,$21,$22,$3a
   107                          !byte $de,$20,$30,$00
   108                          
   109                          ; 20 bank 15:sys 7224
   110                          !text $36,$1c,$14,$00,$fe,$02,$20,$31,$35,$3a,$9e," 7224",$00
   111                          
   112                          end_basic:
   113                          !byte 0, 0
   114                          }
   115                          
