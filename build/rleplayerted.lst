   327                          addbyteto_src_p: ; ; A low, !! Warning: X is set to 0 !! fall through to 16-bit add
   328  1213 a200                   ldx #0
   329                          addto_src_p: ; A low, X high, perform 16-bit addition from/to src_p/src_h
   330  1215 18                     clc
   331  1216 6560                   adc src_p
   332  1218 8560                   sta src_p
   333  121a 8a                     txa
