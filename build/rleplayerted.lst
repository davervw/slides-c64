   539                          index_data:
   540  1223 a900                   lda #0
   541  1225 856a                   sta pages
   542  1227 856b                   sta page
   543                              
   544                          index_loop:
   545                              ; setup index storage offset in .X
   546                              ; .A already has pages
   547  1229 0a                     asl
   548  122a aa                     tax
   549                          
   550                              ; set next index to 0000
   551  122b a900                   lda #0
   552  122d 9d3303                 sta screen_index, x
   553  1230 9d3403                 sta screen_index+1, x
   554                          
   555                              ; do check for start of page (C600 address)
   556  1233 a000                   ldy #0
   557  1235 b160                   lda (src_p),y
   558  1237 d02f                   bne index_exit
   559  1239 c8                     iny
   560  123a b160                   lda (src_p),y
   561  123c c9c6                   cmp #$c6
   562  123e d028                   bne index_exit
   563                          
   564                              ; store indexed page
   565  1240 a560                   lda src_p
   566  1242 9d3303                 sta screen_index, x
   567  1245 a561                   lda src_h
   568  1247 9d3403                 sta screen_index+1, x
   569  124a e66a                   inc pages
   570                          
   571                              ; skip C600 address
   572  124c a902                   lda #2
   573  124e 8569                   sta len ; prep upcoming loop at the same time
   574  1250 207112                 jsr addbyteto_src_p
   575                          
   576                              ; advance past color and text rle data using their lengths
   577  1253 a001               -   ldy #1
   578  1255 b160                   lda (src_p),y
   579  1257 aa                     tax
   580  1258 88                     dey
   581  1259 b160                   lda (src_p),y
   582  125b 207312                 jsr addto_src_p
   583  125e c669                   dec len
   584  1260 d0f1                   bne -
   585                          
   586                              ; while pages < max_pages
   587  1262 a56a                   lda pages
   588  1264 c960                   cmp #max_pages
   589  1266 90c1                   bcc index_loop
   590                          
   591                          index_exit:
   592  1268 a96c                   lda #<start_data
   593  126a a213                   ldx #>start_data
   594  126c 8560                   sta src_p
   595  126e 8661                   stx src_h
   596  1270 60                     rts
   597                          
   598                          addbyteto_src_p: ; ; A low, !! Warning: X is set to 0 !! fall through to 16-bit add
   599  1271 a200                   ldx #0
   600                          addto_src_p: ; A low, X high, perform 16-bit addition from/to src_p/src_h
   601  1273 18                     clc
   602  1274 6560                   adc src_p
   603  1276 8560                   sta src_p
   604  1278 8a                     txa
   605  1279 6561                   adc src_h
   606  127b 8561                   sta src_h
   607  127d 60                     rts
   608                          
   609                          exit_basic:
   610  127e a900                   lda #0
   611  1280 aa                     tax
   612  1281 a001                   ldy #1
   613                          !ifdef TARGET_TED {
   614  1283 20f912                 jsr xlat_set_colors
   615                          } else {
   616                              jsr set_colors
   617                          }
   618                          !ifdef TARGET_C128 {    
   619                              jsr c128_rom_bank_cli
   620                          }
   621                          !ifdef TARGET_TED {    
   622  1286 204513                 jsr ted_rom_bank_cli
   623                          }
   624  1289 a20c                   ldx #12
   625  128b a00c                   ldy #(20-exit_message_len/2)
   626  128d 18                     clc
   627  128e 20f0ff                 jsr plot
   628  1291 a94a                   lda #<exit_message
   629  1293 a213                   ldx #>exit_message
   630  1295 202a13                 jsr string_out
   631  1298 20e4ff             --  jsr getin
   632  129b c900                   cmp #0
   633  129d f0f9                   beq --
   634  129f c913                   cmp #19
   635  12a1 d017                   bne ++
   636  12a3 a900                   lda #0
   637  12a5 856b                   sta page
   638  12a7 a993               -   lda #$93
   639  12a9 20d2ff                 jsr chrout
   640  12ac 201110                 jsr set_slide_colors
   641  12af a56b                   lda page
   642  12b1 c56a                   cmp pages
   643  12b3 9002                   bcc +
   644  12b5 c66b                   dec page
   645  12b7 4c3310             +   jmp screen_loop
   646  12ba c914               ++  cmp #20 ; del (backspace)
   647  12bc f0e9                   beq -
   648  12be c99d                   cmp #157 ; left
   649  12c0 f0e5                   beq -
   650  12c2 c991                   cmp #145 ; up
   651  12c4 f0e1                   beq -
   652  12c6 c931                   cmp #'1'
   653  12c8 9010                   bcc +
   654  12ca c93a                   cmp #('9'+1)
   655  12cc b00c                   bcs +
   656  12ce 38                     sec
   657  12cf e931                   sbc #'1'
   658  12d1 c56a                   cmp pages
   659  12d3 b0c3                   bcs --
   660  12d5 856b                   sta page
   661  12d7 4ca712                 jmp -
   662  12da c958               +   cmp #'X'
   663  12dc d0ba                   bne --
   664                          exit_basic_x:
   665                          !ifdef TARGET_C128 {
   666                              jsr c128_rom_bank_cli
   667                          }
   668  12de a56c                   lda save_border
   669  12e0 a66d                   ldx save_background
   670  12e2 a46e                   ldy save_foreground
   671                          !ifdef TARGET_TED {
   672  12e4 202013                 jsr set_ted_colors ; no translation
   673  12e7 a00e                   ldy #14
   674  12e9 a900               -   lda #0
   675  12eb 996000                 sta src_p,y
   676  12ee 88                     dey
   677  12ef 10f8                   bpl -
   678  12f1 204513                 jsr ted_rom_bank_cli
   679                          } else {
   680                              jsr set_colors
   681                          }
   682  12f4 a993                   lda #$93
   683  12f6 4cd2ff                 jmp chrout ; and exit to BASIC
   684                          
   685                          !ifdef TARGET_TED {
   686                          xlat_set_colors:
   687  12f9 8567                   sta value1
   688  12fb bd5c13                 lda color_table,x
   689  12fe 8d15ff                 sta $ff15 ; background
   690  1301 a667                   ldx value1
   691  1303 bd5c13                 lda color_table,x
   692  1306 8d19ff                 sta $ff19 ; border
   693  1309 b95c13                 lda color_table,y
   694  130c 8d3b05                 sta $053B ; foreground (KERNAL)
   695  130f 60                     rts
   696                          
   697                          save_colors:
   698  1310 ad15ff                 lda $ff15
   699  1313 ae19ff                 ldx $ff19
   700  1316 ac3b05                 ldy $053B
   701  1319 856c                   sta save_border
   702  131b 866d                   stx save_background
   703  131d 846e                   sty save_foreground
   704  131f 60                     rts
   705                          
   706                          set_ted_colors:
   707  1320 8d15ff                 sta $ff15
   708  1323 8e19ff                 stx $ff19
   709  1326 8c3b05                 sty $053B
   710  1329 60                     rts
   711                          } else { ; TARGET_C64 OR TARGET_C128
   712                          set_colors:
   713                              sta border
   714                              stx background   
   715                              sty foreground
   716                              rts
   717                          
   718                          save_colors:
   719                              lda border
   720                              ldx background
   721                              ldy foreground
   722                              sta save_border
   723                              stx save_background
   724                              sty save_foreground
   725                              rts
   726                          }
   727                          
   728                          string_out:
   729  132a 8560                   sta src_p
   730  132c 8661                   stx src_h
   731  132e a000                   ldy #0
   732  1330 b160               -   lda (src_p), y
   733  1332 f00b                   beq +
   734  1334 20d2ff                 jsr chrout
   735  1337 c8                     iny
   736  1338 d0f6                   bne -
   737  133a e661                   inc src_h
   738  133c 4c3013                 jmp -
   739  133f 60                 +   rts
   740                          
   741                          !ifdef TARGET_C128 {
   742                          sei_c128_ram_bank:
   743                              sei
   744                              lda #$06 ; RAM bank 0 0000-CFFF, IO D000-DFFF, KERNAL E000-FFFF
   745                              sta $FF00
   746                              rts
   747                          
   748                          c128_rom_bank_cli:
   749                              lda #$00
   750                              sta $FF00
   751                              cli
   752                              rts
   753                          }
   754                          
   755                          !ifdef TARGET_TED {
   756                          sei_ted_ram_bank:
   757  1340 78                     sei
   758  1341 8d3fff                 sta $ff3f ; bank in RAM
   759  1344 60                     rts
   760                          
   761                          ted_rom_bank_cli:
   762  1345 8d3eff                 sta $ff3e ; bank in ROM
   763  1348 58                     cli
   764  1349 60                     rts
   765                          }
   766                          
   767                          exit_message:
   768  134a 2850524553532058...    !text "(PRESS X TO EXIT)"
   769                          exit_message_len = * - exit_message    
   770  135b 00                     !byte 0
   771                          
   772                          !ifdef TARGET_TED {
   773                          ; C64 color to TED color mappings
   774  135c 0071426354552677...color_table:  !byte $00,$71,$42,$63,$54,$55,$26,$77,$58,$38,$6B,$31,$41,$7F,$56,$61
   775                          }
