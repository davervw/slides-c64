   272                          index_loop:
   273                              ; setup index storage offset in .X
   274                              ; .A already has pages
   275  11cb 0a                     asl
   276  11cc aa                     tax
   277                          
   278                              ; set next index to 0000
   279  11cd a900                   lda #0
   280  11cf 9d3303                 sta screen_index, x
   281  11d2 9d3403                 sta screen_index+1, x
   282                          
   283                              ; do check for start of page (C600 address)
   284  11d5 a000                   ldy #0
   285  11d7 b160                   lda (src_p),y
   286  11d9 d02f                   bne index_exit
   287  11db c8                     iny
   288  11dc b160                   lda (src_p),y
   289  11de c9c6                   cmp #$c6
   290  11e0 d028                   bne index_exit
   291                          
   292                              ; store indexed page
   293  11e2 a560                   lda src_p
   294  11e4 9d3303                 sta screen_index, x
   295  11e7 a561                   lda src_h
   296  11e9 9d3403                 sta screen_index+1, x
   297  11ec e66a                   inc pages
   298                          
   299                              ; skip C600 address
   300  11ee a902                   lda #2
   301  11f0 8569                   sta len ; prep upcoming loop at the same time
   302  11f2 201312                 jsr addbyteto_src_p
   303                          
   304                              ; advance past color and text rle data using their lengths
   305  11f5 a001               -   ldy #1
   306  11f7 b160                   lda (src_p),y
   307  11f9 aa                     tax
   308  11fa 88                     dey
   309  11fb b160                   lda (src_p),y
   310  11fd 201512                 jsr addto_src_p
   311  1200 c669                   dec len
   312  1202 d0f1                   bne -
   313                          
   314                              ; while pages < max_pages
   315  1204 a56a                   lda pages
   316  1206 c960                   cmp #max_pages
   317  1208 90c1                   bcc index_loop
   318                          
   319                          index_exit:
   320                              ; reset start_data
   321  120a a93f                   lda #<start_data
   322  120c a212                   ldx #>start_data
   323  120e 8560                   sta src_p
   324  1210 8661                   stx src_h
   325  1212 60                     rts
