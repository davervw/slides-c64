    36                          
    37                          chrout = $FFD2 ; character out to device (normally screen)
    38                          getin = $FFE4 ; read character from keyboard, 0=no key
    39                          plot = $FFF0 ; C clear sets cursor position X=row, Y=col, or if C set gets cursor position
    40                          
    41                          !ifdef TARGET_C64 {
    42                          src_p=$FB
    43                          src_h=$FC
    44                          dst_p=$FD
    45                          dst_h=$FE
    46                          special=$FF
    47                          end_src_p=$22
    48                          end_src_h=$23
    49                          value=$24
    50                          len=$25
    51                          pages=$26 ; count of pages indexed
    52                          page=$27 ; 0 based
    53                          save_border=$28
    54                          save_background=$29
    55                          save_foreground=$2a
    56                          
    57                          screen_index = $33C
    58                          max_pages = 96
    59                          
    60                          text_addr=$0400
    61                          color_addr=$d800
    62                          
    63                          border=$d020
    64                          background=$d021
    65                          foreground=646
    66                          
    67                          *=$801
    68                          
    69                          ; 10 SYS 2062
    70  0801 0c08               !byte <end_basic, >end_basic
    71  0803 0a009e2032303632...!text 10, 0, $9E, " 2062", 0
    72                          end_basic:
    73  080c 0000               !byte 0, 0
    74                          }
    75                          
    76                          !ifdef TARGET_C128 {
    77                          src_p=$FB
    78                          src_h=$FC
    79                          dst_p=$FD
    80                          dst_h=$FE
    81                          special=$FA
    82                          end_src_p=$61
    83                          end_src_h=$62
    84                          value=$63
    85                          len=$64
    86                          pages=$65
    87                          page=$66
    88                          save_border=$67
    89                          save_background=$68
    90                          save_foreground=$69
    91                          
    92                          screen_index=$0B00
    93                          max_pages=127
    94                          
    95                          text_addr=$0400
    96                          color_addr=$d800
    97                          
    98                          border=$d020
    99                          background=$d021
   100                          foreground=241
   101                          
   102                          *=$1C01
   103                          
   104                          ; 10 graphic 5,1:printchr$(15)"graphic 0 !!!":graphic 0
   105                          !byte $25,$1c,$0a,$00,$de,$20,$35,$2c,$31,$3a,$99,$c7,$28,$31,$35,$29
   106                          !byte $22,$47,$52,$41,$50,$48,$49,$43,$20,$30,$20,$21,$21,$21,$22,$3a
   107                          !byte $de,$20,$30,$00
   108                          
   109                          ; 20 bank 15:sys 7224
   110                          !text $36,$1c,$14,$00,$fe,$02,$20,$31,$35,$3a,$9e," 7224",$00
   111                          
   112                          end_basic:
   113                          !byte 0, 0
   114                          }
   115                          
   116                          !ifdef TARGET_TED { ; Commodore 16, 116, Plus/4, etc.
   117                          src_p=$60
   118                          src_h=$61
   119                          dst_p=$62
   120                          dst_h=$63
   121                          special=$64
   122                          end_src_p=$65
   123                          end_src_h=$66
   124                          value1=$67
   125                          value2=$68
   126                          len=$69
   127                          pages=$6A
   128                          page=$6B
   129                          save_border=$6C
   130                          save_background=$6D
   131                          save_foreground=$6E
   132                          
   133                          screen_index=$333
   134                          max_pages=96
   135                          
   136                          text_addr=$0c00
   137                          color_addr=$0800
   138                          
   139                          *=$1001
   140                          
   141                          ; 10 SYS 4110
   142                          !byte <end_basic, >end_basic
