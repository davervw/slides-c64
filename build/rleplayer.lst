
; ******** Source: code/rleplayer.asm
     1                          *=$801
     2                          
     3                          chrout = $FFD2 ; character out to device (normally screen)
     4                          getin = $FFE4 ; read character from keyboard, 0=no key
     5                          
     6                          src_p=$FB
     7                          src_h=$FC
     8                          dst_p=$FD
     9                          dst_h=$FE
    10                          special=$FF
    11                          end_src_p=$22
    12                          end_src_h=$23
    13                          value=$24
    14                          len=$25
    15                          pages=$26 ; count of pages indexed
    16                          page=$27 ; 0 based
    17                          
    18                          screen_index = $33C
    19                          max_pages = 96
    20                          
    21                          ; 10 SYS 2062
    22  0801 0d08               !byte <end_basic, >end_basic
    23  0803 0a009e2032303632...!text 10, 0, $9E, " 2062", 0, 0
    24                          end_basic:
    25  080d 00                 !byte 0
    26                          
    27                          screen_player:
    28  080e a90e                   lda #$0e
    29  0810 a206                   ldx #$06
    30  0812 8d20d0                 sta $d020
    31  0815 8e21d0                 stx $d021
    32  0818 8d8602                 sta 646
    33  081b a993                   lda #$93
    34  081d 20d2ff                 jsr chrout
    35  0820 a9e9                   lda #<start_data
    36  0822 a209                   ldx #>start_data
    37  0824 85fb                   sta src_p
    38  0826 86fc                   stx src_h
    39  0828 208e09                 jsr index_data
    40                          screen_loop: 
    41  082b a527                   lda page
    42  082d c526                   cmp pages
    43  082f 9001                   bcc +
    44  0831 60                     rts
    45  0832 0a                 +   asl
    46  0833 a8                     tay
    47  0834 b93c03                 lda screen_index,y
    48  0837 be3d03                 ldx screen_index+1,y
    49  083a 85fb                   sta src_p
    50  083c 86fc                   stx src_h
    51  083e a902                   lda #2
    52  0840 a200                   ldx #0
    53  0842 20de09                 jsr addto_src_p
    54  0845 a900                   lda #$00
    55  0847 a2d8                   ldx #$d8
    56  0849 85fd                   sta dst_p
    57  084b 86fe                   stx dst_h
    58  084d 20a508                 jsr decode_color
    59  0850 a900                   lda #$00
    60  0852 a204                   ldx #$04
    61  0854 85fd                   sta dst_p
    62  0856 86fe                   stx dst_h
    63  0858 202409                 jsr decode_text
    64  085b 20e4ff             -   jsr getin
    65  085e c900                   cmp #$00
    66  0860 f0f9                   beq -
    67  0862 c903                   cmp #3
    68  0864 d005                   bne +
    69  0866 a993                   lda #$93
    70  0868 4cd2ff                 jmp chrout
    71  086b c914               +   cmp #20 ; delete
    72  086d d009                   bne +
    73  086f a527               --  lda page ; check if can backup a page
    74  0871 f0e8                   beq -
    75  0873 c627                   dec page
    76  0875 4c9d08                 jmp ++
    77  0878 c99d               +   cmp #157 ; left
    78  087a f0f3                   beq --
    79  087c c991                   cmp #145 ; up
    80  087e f0ef                   beq --
    81  0880 c931                   cmp #'1'
    82  0882 900f                   bcc +
    83  0884 c93a                   cmp #('9'+1)
    84  0886 b00b                   bcs +
    85  0888 38                     sec        ; 1..9
    86  0889 e931                   sbc #'1'   ; because 0 based
    87  088b c526               --  cmp pages
    88  088d b0cc                   bcs -      ; ignore key if out of range
    89  088f 8527                   sta page
    90  0891 900a                   bcc ++
    91  0893 c930               +   cmp #'0'
    92  0895 d004                   bne +
    93  0897 a90a                   lda #10    ; try page 10
    94  0899 d0f0                   bne --   
    95  089b e627               +   inc page   ; any other key, advance page
    96                          ++
    97  089d a993                   lda #$93   ; before switching page, clear screen
    98  089f 20d2ff                 jsr chrout
    99  08a2 4c2b08                 jmp screen_loop
   100                          
   101                          decode_color:
   102  08a5 18                     clc
   103  08a6 a000                   ldy #$00
   104  08a8 b1fb                   lda (src_p),y
   105  08aa 65fb                   adc src_p
   106  08ac 8522                   sta end_src_p
   107  08ae c8                     iny
   108  08af b1fb                   lda (src_p),y
   109  08b1 65fc                   adc src_h
   110  08b3 8523                   sta end_src_h
   111  08b5 c8                     iny
   112  08b6 b1fb                   lda (src_p),y
   113  08b8 85ff                   sta special
   114  08ba a903                   lda #3
   115  08bc a200                   ldx #0
   116  08be 20de09                 jsr addto_src_p
   117                          color_loop: 
   118  08c1 a000                   ldy #$00
   119  08c3 b1fb                   lda (src_p),y
   120  08c5 c5ff                   cmp special
   121  08c7 f01e                   beq ++
   122  08c9 c8                     iny
   123  08ca 91fd                   sta (dst_p),y
   124  08cc 88                     dey
   125  08cd 4a                     lsr
   126  08ce 4a                     lsr
   127  08cf 4a                     lsr
   128  08d0 4a                     lsr
   129  08d1 91fd                   sta (dst_p),y
   130  08d3 e6fb                   inc src_p
   131  08d5 d002                   bne +
   132  08d7 e6fc                   inc src_h
   133  08d9 18                 +   clc
   134  08da a5fd                   lda dst_p
   135  08dc 6902                   adc #$02
   136  08de 85fd                   sta dst_p
   137  08e0 9002                   bcc +
   138  08e2 e6fe                   inc dst_h
   139  08e4 4c1509             +   jmp color_while
   140  08e7 c8                 ++  iny
   141  08e8 b1fb                   lda (src_p),y
   142  08ea 8524                   sta value
   143  08ec c8                     iny
   144  08ed b1fb                   lda (src_p),y
   145  08ef 8525                   sta len
   146  08f1 a903                   lda #3
   147  08f3 a200                   ldx #0
   148  08f5 20de09                 jsr addto_src_p
   149  08f8 a625                   ldx len
   150                          color_rle_loop: 
   151  08fa a524                   lda value
   152  08fc a001                   ldy #$01
   153  08fe 91fd                   sta (dst_p),y
   154  0900 88                     dey
   155  0901 4a                     lsr
   156  0902 4a                     lsr
   157  0903 4a                     lsr
   158  0904 4a                     lsr
   159  0905 91fd                   sta (dst_p),y
   160  0907 18                     clc
   161  0908 a5fd                   lda dst_p
   162  090a 6902                   adc #$02
   163  090c 85fd                   sta dst_p
   164  090e 9002                   bcc +
   165  0910 e6fe                   inc dst_h
   166  0912 ca                 +   dex
   167  0913 d0e5                   bne color_rle_loop
   168                          color_while:
   169  0915 a5fb                   lda src_p
   170  0917 a6fc                   ldx src_h
   171  0919 e423                   cpx end_src_h
   172  091b 90a4                   bcc color_loop
   173  091d d004                   bne +
   174  091f c522                   cmp end_src_p
   175  0921 909e                   bcc color_loop
   176  0923 60                 +   rts
   177                          
   178                          decode_text:
   179  0924 18                     clc
   180  0925 a000                   ldy #$00
   181  0927 b1fb                   lda (src_p),y
   182  0929 65fb                   adc src_p
   183  092b 8522                   sta end_src_p
   184  092d c8                     iny
   185  092e b1fb                   lda (src_p),y
   186  0930 65fc                   adc src_h
   187  0932 8523                   sta end_src_h
   188  0934 c8                     iny
   189  0935 b1fb                   lda (src_p),y
   190  0937 85ff                   sta special
   191  0939 a903                   lda #3
   192  093b a200                   ldx #0
   193  093d 20de09                 jsr addto_src_p
   194                          text_loop:
   195  0940 a000                   ldy #$00
   196  0942 b1fb                   lda (src_p),y
   197  0944 c5ff                   cmp special
   198  0946 f011                   beq ++
   199  0948 91fd                   sta (dst_p),y
   200  094a e6fb                   inc src_p
   201  094c d002                   bne +
   202  094e e6fc                   inc src_h
   203  0950 e6fd               +   inc dst_p
   204  0952 d002                   bne +
   205  0954 e6fe                   inc dst_h
   206  0956 4c7f09             +   jmp text_while
   207  0959 c8                 ++  iny
   208  095a b1fb                   lda (src_p),y
   209  095c 8524                   sta value
   210  095e c8                     iny
   211  095f b1fb                   lda (src_p),y
   212  0961 8525                   sta len
   213  0963 a903                   lda #$03
   214  0965 18                     clc
   215  0966 65fb                   adc src_p
   216  0968 85fb                   sta src_p
   217  096a 9002                   bcc +
   218  096c e6fc                   inc src_h
   219  096e a625               +   ldx len
   220                          text_rle_loop: 
   221  0970 a524                   lda value
   222  0972 a000                   ldy #$00
   223  0974 91fd                   sta (dst_p),y
   224  0976 e6fd                   inc dst_p
   225  0978 d002                   bne +
   226  097a e6fe                   inc dst_h
   227  097c ca                 +   dex
