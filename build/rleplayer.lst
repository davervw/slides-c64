   239                          index_data:
   240  098e a900                   lda #0
   241  0990 8526                   sta pages
   242  0992 8527                   sta page
   243                              
   244                          index_loop:
   245                              ; setup index storage offset in .X
   246                              ; .A already has pages
   247  0994 0a                     asl
   248  0995 aa                     tax
   249                          
   250                              ; set next index to 0000
   251  0996 a900                   lda #0
   252  0998 9d3c03                 sta screen_index, x
   253  099b 9d3d03                 sta screen_index+1, x
   254                          
   255                              ; do check for start of page (C600 address)
   256  099e a000                   ldy #0
   257  09a0 b1fb                   lda (src_p),y
   258  09a2 d031                   bne index_exit
   259  09a4 c8                     iny
   260  09a5 b1fb                   lda (src_p),y
   261  09a7 c9c6                   cmp #$c6
   262  09a9 d02a                   bne index_exit
   263                          
   264                              ; store indexed page
   265  09ab a5fb                   lda src_p
   266  09ad 9d3c03                 sta screen_index, x
   267  09b0 a5fc                   lda src_h
   268  09b2 9d3d03                 sta screen_index+1, x
   269  09b5 e626                   inc pages
   270                          
   271                              ; skip C600 address
   272  09b7 a902                   lda #2
   273  09b9 8525                   sta len ; prep upcoming loop at the same time
   274  09bb a200                   ldx #0
   275  09bd 20de09                 jsr addto_src_p
   276                          
   277                              ; advance past color and text rle data using their lengths
   278  09c0 a001               -   ldy #1
   279  09c2 b1fb                   lda (src_p),y
   280  09c4 aa                     tax
   281  09c5 88                     dey
   282  09c6 b1fb                   lda (src_p),y
   283  09c8 20de09                 jsr addto_src_p
   284  09cb c625                   dec len
   285  09cd d0f1                   bne -
   286                          
   287                              ; while pages < max_pages
   288  09cf a526                   lda pages
   289  09d1 c960                   cmp #max_pages
   290  09d3 90bf                   bcc index_loop
   291                          
   292                          index_exit:
   293  09d5 a9e9                   lda #<start_data
   294  09d7 a209                   ldx #>start_data
   295  09d9 85fb                   sta src_p
   296  09db 86fc                   stx src_h
   297  09dd 60                     rts
   298                          
   299                          addto_src_p: ; A low, X high, perform 16-bit addition from/to src_p/src_h
   300  09de 18                     clc
   301  09df 65fb                   adc src_p
   302  09e1 85fb                   sta src_p
   303  09e3 8a                     txa
   304  09e4 65fc                   adc src_h
   305  09e6 85fc                   sta src_h
   306  09e8 60                     rts
   307                          
   308                          start_data:
