   266                          index_loop:
   267                              ; setup index storage offset in .X
   268                              ; .A already has pages
   269  09b0 0a                     asl
   270  09b1 aa                     tax
   271                          
   272                              ; set next index to 0000
   273  09b2 a900                   lda #0
   274  09b4 9d3c03                 sta screen_index, x
   275  09b7 9d3d03                 sta screen_index+1, x
   276                          
   277                              ; do check for start of page (C600 address)
   278  09ba a000                   ldy #0
   279  09bc b1fb                   lda (src_p),y
   280  09be d031                   bne index_exit
   281  09c0 c8                     iny
   282  09c1 b1fb                   lda (src_p),y
   283  09c3 c9c6                   cmp #$c6
   284  09c5 d02a                   bne index_exit
   285                          
   286                              ; store indexed page
   287  09c7 a5fb                   lda src_p
   288  09c9 9d3c03                 sta screen_index, x
   289  09cc a5fc                   lda src_h
   290  09ce 9d3d03                 sta screen_index+1, x
   291  09d1 e626                   inc pages
   292                          
   293                              ; skip C600 address
   294  09d3 a902                   lda #2
   295  09d5 8525                   sta len ; prep upcoming loop at the same time
   296  09d7 a200                   ldx #0
   297  09d9 20fa09                 jsr addto_src_p
   298                          
   299                              ; advance past color and text rle data using their lengths
   300  09dc a001               -   ldy #1
   301  09de b1fb                   lda (src_p),y
   302  09e0 aa                     tax
   303  09e1 88                     dey
   304  09e2 b1fb                   lda (src_p),y
   305  09e4 20fa09                 jsr addto_src_p
   306  09e7 c625                   dec len
   307  09e9 d0f1                   bne -
   308                          
   309                              ; while pages < max_pages
   310  09eb a526                   lda pages
   311  09ed c960                   cmp #max_pages
   312  09ef 90bf                   bcc index_loop
   313                          
   314                          index_exit:
   315  09f1 a9b2                   lda #<start_data
   316  09f3 a20a                   ldx #>start_data
